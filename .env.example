DEMO_MODE=true
# empty = embedded PGlite in .data/ ; set for Postgres / Tiger Cloud
DATABASE_URL=
# required when DEMO_MODE=false: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# demo default passcode: demo
CONSULTANT_PASSCODE=
HELP_LINK_SECRET=

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gemma3:4b
# gemma-api = Gemma on Google AI Studio (public demo): no system role / JSON mode, handled in llm.ts
LLM_COMPAT=
DECODER_BASE_URL=http://127.0.0.1:8791/v1
# fine-tuned decoder served by llama-server (ml/decoder/run.mjs); set to the LLM_MODEL value to use Gemma few-shot only
DECODER_MODEL=pfdesk-decoder
EMBED_MODEL=nomic-embed-text

# local = open TabPFN in ml/tabpfn/.venv (v2, ungated); api = Prior Labs cloud (needs TABPFN_API_KEY)
TABPFN_MODE=local
TABPFN_API_KEY=
# optional: accepting the TabPFN license at https://ux.priorlabs.ai gives a token that unlocks local v3.5
TABPFN_TOKEN=
TABPFN_PORT=8790
TABPFN_URL=http://127.0.0.1:8790
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
# off = do not run the Temporal worker inside the API (then run `pnpm --filter api worker`)
TEMPORAL_WORKER=
# N = a monthly-cycle "day" lasts N seconds (demos/tests); empty = real calendar
CYCLE_FAST=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_SHARED_SECRET=
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SERPAPI_KEY=
BACKBOARD_API_KEY=

API_PORT=8787
API_URL=http://localhost:8787
# base for employee help links; set to your domain when deployed
PUBLIC_URL=http://localhost:3000

# Phase 3: Tinker fine-tuning (console -> API keys)
TINKER_API_KEY=
