{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "seed": "node --env-file-if-exists=../../.env src/seed.ts --reset",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "export-history": "node --env-file-if-exists=../../.env src/export-history.ts",
    "worker": "node --env-file-if-exists=../../.env src/worker.ts",
    "durability": "node --env-file-if-exists=../../.env src/durability.ts",
    "bench:search": "node --env-file-if-exists=../../.env src/bench-search.ts",
    "bench:checks": "node src/bench-checks.ts",
    "bench:helpline": "node --env-file-if-exists=../../.env src/bench-helpline.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-pgvector": "0.0.10",
    "@faker-js/faker": "^10.6.0",
    "@hono/node-server": "^2.1.4",
    "@sentry/node": "^10.76.2",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
